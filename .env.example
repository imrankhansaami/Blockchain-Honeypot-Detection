# =============================================================================
# Blockchain Honeypot Detection Tool - example environment
# Copy to .env and fill in. NEVER commit real keys or endpoints.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# SQLite is the zero-setup default. For production use PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/honeypot
DATABASE_URL=sqlite+pysqlite:///./data/honeypot.db
DB_ECHO=false

# --- RPC endpoints (leave blank to disable a chain) ---
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=

# --- Explorer API keys (Etherscan/BscScan) ---
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=

# --- RPC hardening ---
RPC_TIMEOUT_SECONDS=20
RPC_MAX_RETRIES=2
# Optional comma-separated allow-list of RPC hosts (SSRF protection).
RPC_ALLOWED_HOSTS=

# --- Simulation (Foundry Anvil) ---
SIMULATION_ENABLED=true
ANVIL_BINARY=anvil
FORK_TIMEOUT_SECONDS=120
ANVIL_PORT_RANGE_START=8600
ANVIL_PORT_RANGE_END=8700
SIM_BUY_AMOUNT_WEI=100000000000000000

# --- Reports ---
REPORT_OUTPUT_DIR=./data/reports

# --- Rate limiting ---
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_DEFAULT=120/minute

# --- Background tasks ---
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Static analysis ---
SLITHER_ENABLED=false
SLITHER_BINARY=slither
SLITHER_TIMEOUT_SECONDS=180
