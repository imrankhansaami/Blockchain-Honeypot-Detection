# Linguist settings so GitHub's language breakdown reflects this project
# accurately. The Solidity contracts are first-class source; vendored libraries
# and generated/documentation files are excluded from the language statistics.

# Vendored dependencies (also git submodules) must not count.
contracts/lib/** linguist-vendored

# Documentation is documentation, not application source.
docs/** linguist-documentation
*.md linguist-documentation

# Generated example reports are build output.
docs/examples/** linguist-generated
frontend/out/** linguist-generated
frontend/.next/** linguist-generated
frontend/package-lock.json linguist-generated

# Make the Solidity language explicit for every Solidity source and test.
*.sol linguist-language=Solidity
contracts/**/*.sol linguist-language=Solidity
